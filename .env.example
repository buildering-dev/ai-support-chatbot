# Copy to .env and fill in. Never commit .env.

BUSINESS_NAME=Harbour Bikes (demo)
DOCS_DIR=data/sample_docs

# offline | anthropic | openai
#   offline   - no key needed; quotes the best-matching passage (demo / fallback)
#   anthropic - Claude models (set ANTHROPIC_API_KEY)
#   openai    - any OpenAI-compatible API: OpenAI, OpenRouter, Groq, local Ollama
LLM_PROVIDER=offline
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Guardrails
TOP_K=4
MIN_SCORE=1.0
HISTORY_TURNS=6

# Web
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MIN=20

# Telegram (optional) - create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
